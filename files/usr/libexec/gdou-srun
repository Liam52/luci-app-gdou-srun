#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""GDou srun 认证（OpenWrt 用）

只做一件事：把路由器登录到广东海洋大学校园网（深澜 srun）。

用法：
    gdou-srun login     执行一次认证，成功返回 0；输出一行 JSON
    gdou-srun check     检查是否已联网（已联网返回 0）
    gdou-srun status    打印最近一次结果
    gdou-srun acid      打印将要使用的 ac_id 及其来源
    gdou-srun logout    主动下线
    gdou-srun renew [秒] 下线后重新登录（默认等 5 秒）
"""

import base64
import hashlib
import http.client
import hmac
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# OpenWrt 的 python3-light 往往缺少 idna 编码，urllib 构造 Host 头时会因此报错。
# 这里注册一个纯 ASCII 的直通编码，避免额外依赖 python3-codecs。
import codecs as _codecs


def _ensure_idna():
    try:
        "probe".encode("idna")
        return
    except LookupError:
        pass

    def _search(name):
        if name.replace("_", "-").lower() != "idna":
            return None

        def _encode(text, errors="strict"):
            return text.encode("ascii", errors), len(text)

        def _decode(data, errors="strict"):
            text = data.decode("ascii", errors) if isinstance(data, bytes) else str(data)
            return text, len(text)

        return _codecs.CodecInfo(name="idna", encode=_encode, decode=_decode)

    _codecs.register(_search)


_ensure_idna()

# 多链路：把认证请求绑定到指定网卡发出（SO_BINDTODEVICE），
# 这样每条 macvlan 链路都能用自己的 IP 去门户认证。
BIND_IFACE = os.environ.get("GDOU_IFACE", "")
BIND_SOURCE = os.environ.get("GDOU_SOURCE_IP", "")
CONFIG = os.environ.get("GDOU_CONFIG", "/etc/config/gdou-srun")
STATE = os.environ.get("GDOU_STATE", "/tmp/gdou-srun.state")

B64_ALPHABET = "LVoJPiCN2R8G90yg+hmFHuacZ1OWMnrsSTXkYpUq/3dlbfKwv6xztjI7DeBE45QA"
B64_STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# 用于从「断网被劫持」的跳转里读出本机真实 ac_id
PROBE_URLS = [
    "http://connect.rom.miui.com/generate_204",
    "http://www.baidu.com",
    "http://1.1.1.1",
]


# ---------------- UCI 配置 ----------------
def read_config():
    cfg = {
        "enabled": "1",
        "username": "",
        "password": "",
        "server": "http://10.129.1.1",
        "acid": "25",
        "manual_acid": "",
        "last_good_acid": "",
        "n": "200",
        "type": "1",
        "test_host": "www.baidu.com",
        "test_port": "80",
        "interval": "30",
        "auto_agree": "1",
        "portal_os": "HarmonyOS",
        "portal_name": "Huawei",
        "advanced": "0",
        "auto_apply": "0",
        "dual_same_account": "0",
        "split_mode": "backup",
        "sub_username": "",
        "sub_password": "",
        "sub1_enabled": "0",
        "sub1_username": "",
        "sub1_password": "",
        "sub1_dual": "0",
        "sub2_enabled": "0",
        "sub2_username": "",
        "sub2_password": "",
        "sub2_dual": "0",
        "sub3_enabled": "0",
        "sub3_username": "",
        "sub3_password": "",
        "sub3_dual": "0",
        "sub4_enabled": "0",
        "sub4_username": "",
        "sub4_password": "",
        "sub4_dual": "0",
    }
    try:
        with open(CONFIG, "rb") as fh:
            raw = fh.read()
    except OSError:
        return cfg

    # 配置文件里混进非 UTF-8 字节时不要让整个程序崩掉，按替换字符处理即可。
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        text = raw.decode("utf-8", "replace")
    text = text.replace("\x00", "")

    section = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("config "):
            section = line.split()[1].strip("'\"")
            continue
        m = re.match(r"option\s+(\S+)\s+'(.*)'$", line)
        if section in ("gdou-srun", "gdou_srun") and m:
            cfg[m.group(1)] = m.group(2)
    cfg["server"] = cfg["server"].rstrip("/")
    return cfg


# 文档里「示例值」被原样粘贴进配置是实际发生过的事故：密码变成占位符，
# 门户返回 E2901，而插件只会说「账号或密码错误」，看起来像学校把人踢了。
PLACEHOLDER_VALUES = {
    "你的密码", "密码", "你的学号", "学号", "账号", "用户名",
    "password", "passwd", "your_password", "yourpassword",
    "<你的密码>", "<密码>", "<your password>",
}


def placeholder_hint(cfg):
    """识别占位符被当成真值填进来的情况，返回提示语；正常则返回空串。"""
    for label, key in (("账号", "username"), ("密码", "password")):
        val = (cfg.get(key) or "").strip()
        if not val:
            continue
        low = val.lower()
        if val in PLACEHOLDER_VALUES or low in PLACEHOLDER_VALUES:
            return "%s还是占位符「%s」，请在 LuCI 里改成真实的%s" % (label, val, label)
        if (val.startswith("<") and val.endswith(">")) or val.startswith("请填写"):
            return "%s还是占位符「%s」，请在 LuCI 里改成真实的%s" % (label, val, label)
    return ""


ACID_STATE = os.environ.get("GDOU_ACID_STATE", "/tmp/gdou-srun.acid")


def load_saved_acids():
    """读取上次成功的 ac_id（存 /tmp，不写 uci）。

    早期版本把 ac_id 写回 uci，问题是：
      1. 每次登录成功都要 uci commit，也就是每次登录写一次 flash；
      2. 多个脚本并发 uci set/commit 时，uci 不是并发安全的，
         会把 /etc/config/gdou-srun 写坏（实测丢过十几项配置）。
    改存 /tmp 后两个问题一起消失；重启后重新发现 ac_id 也只要 1~2 秒。
    """
    try:
        with open(ACID_STATE, "r", encoding="utf-8") as fh:
            return json.load(fh) or {}
    except (OSError, ValueError):
        return {}


def save_acids(last_good, manual=None):
    """记住这次成功的 ac_id，下次启动优先用它。

    只写 /tmp 下的状态文件，不碰 uci：uci 在并发写入时会写坏配置，
    而且 commit 会写 flash，登录成功一次写一次并不合适。
    """
    data = load_saved_acids()
    if isinstance(last_good, int) and last_good > 0:
        data["last_good"] = last_good
    if manual is not None and str(manual).strip().isdigit():
        data["manual"] = str(manual).strip()
    try:
        with open(ACID_STATE, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False)
    except OSError:
        pass


# ---------------- srun 协议 ----------------
def x_encode(msg, key):
    """深澜 xEncode（xxtea 变体）。"""
    def mix(buf, append_size):
        res = []
        for i in range(0, len(buf), 4):
            chunk = buf[i:i + 4]
            val = 0
            for j in range(4):
                val |= (chunk[j] if j < len(chunk) else 0) << (8 * j)
            res.append(val & 0xFFFFFFFF)
        if append_size:
            res.append(len(buf) & 0xFFFFFFFF)
        return res

    v = mix(msg.encode("utf-8"), True)
    k = mix(key.encode("utf-8"), False)
    while len(k) < 4:
        k.append(0)

    n = len(v) - 1
    z = v[n]
    y = v[0]
    c = 0x9E3779B9
    d = 0
    q = 6 + 52 // (n + 1)

    while q > 0:
        d = (d + c) & 0xFFFFFFFF
        e = (d >> 2) & 3
        for p in range(n):
            y = v[p + 1]
            m = ((z >> 5) ^ (y << 2)) & 0xFFFFFFFF
            m = (m + (((y >> 3) ^ (z << 4) ^ (d ^ y)) & 0xFFFFFFFF)) & 0xFFFFFFFF
            m = (m + (k[(p & 3) ^ e] ^ z)) & 0xFFFFFFFF
            z = v[p] = (v[p] + m) & 0xFFFFFFFF
        y = v[0]
        m = ((z >> 5) ^ (y << 2)) & 0xFFFFFFFF
        m = (m + (((y >> 3) ^ (z << 4) ^ (d ^ y)) & 0xFFFFFFFF)) & 0xFFFFFFFF
        m = (m + (k[(n & 3) ^ e] ^ z)) & 0xFFFFFFFF
        z = v[n] = (v[n] + m) & 0xFFFFFFFF
        q -= 1

    out = bytearray()
    for val in v:
        out.extend((val & 0xFF, (val >> 8) & 0xFF, (val >> 16) & 0xFF, (val >> 24) & 0xFF))
    return bytes(out)


def srun_b64(raw):
    std = base64.b64encode(raw).decode("ascii")
    return "".join(B64_ALPHABET[B64_STD.index(ch)] if ch in B64_STD else ch for ch in std)


class BoundHTTPConnection(http.client.HTTPConnection):
    """把 socket 绑到指定网卡再连接。SO_BINDTODEVICE = 25。"""

    def connect(self):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        if BIND_SOURCE:
            # 源 IP 绑定：配合 ip rule from <源IP> lookup <表>，完全不碰主路由表
            self.sock.bind((BIND_SOURCE, 0))
        elif BIND_IFACE:
            self.sock.setsockopt(socket.SOL_SOCKET, 25, BIND_IFACE.encode())
        self.sock.connect((self.host, self.port))


def http_get_bound(url, timeout=8):
    u = urllib.parse.urlparse(url)
    conn = BoundHTTPConnection(u.hostname, u.port or 80, timeout=timeout)
    path = u.path or "/"
    if u.query:
        path += "?" + u.query
    try:
        conn.request("GET", path, headers={"User-Agent": "gdou-srun"})
        return conn.getresponse().read().decode("utf-8", "replace")
    finally:
        conn.close()


def http_get(url, timeout=8):
    if (BIND_IFACE or BIND_SOURCE) and url.startswith("http://"):
        return http_get_bound(url, timeout)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "gdou-srun"})
        return urllib.request.urlopen(req, timeout=timeout).read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.read().decode("utf-8", "replace")


def parse_jsonp(text):
    start = text.find("(")
    end = text.rfind(")")
    if start < 0 or end <= start:
        raise ValueError("认证服务器返回异常：%s" % text[:80])
    return json.loads(text[start + 1:end])


def get_challenge(server, username, timeout, ip=None):
    ts = str(int(time.time()) - 2)
    url = "%s/cgi-bin/get_challenge?%s" % (
        server,
        urllib.parse.urlencode({"callback": "sdu", "username": username, "ip": ip or "", "_": ts}),
    )
    return parse_jsonp(http_get(url, timeout))


def login_once(cfg, acid):
    server = cfg["server"]
    username = cfg.get("username", "")
    password = cfg.get("password", "")
    n = cfg.get("n", "200")
    utype = cfg.get("type", "1")
    timeout = 10

    first = get_challenge(server, username, timeout)
    ip = first.get("online_ip") or first.get("client_ip") or ""
    if not ip:
        return {"ok": False, "kind": "network", "msg": "认证服务器未返回本机 IP", "acid": acid}

    chal = get_challenge(server, username, timeout, ip)
    token = chal.get("challenge") or first.get("challenge")
    if not token:
        return {"ok": False, "kind": "network", "msg": "认证服务器未返回 challenge", "acid": acid}
    ip = chal.get("online_ip") or chal.get("client_ip") or ip

    hmd5 = hmac.new(token.encode(), password.encode(), hashlib.md5).hexdigest()
    info_json = json.dumps(
        {"username": username, "password": password, "ip": ip, "acid": int(acid), "enc_ver": "srun_bx1"},
        separators=(",", ":"),
    )
    info = "{SRBX1}" + srun_b64(x_encode(info_json, token))

    joined = "".join([token, username, token, hmd5, token, str(acid), token, ip,
                      token, str(n), token, str(utype), token, info])
    chksum = hashlib.sha1(joined.encode()).hexdigest()

    # 上报给门户的设备标识：os / name 两个字段客户端可自定义，留空则用默认值。
    portal_os = (cfg.get("portal_os") or "").strip() or "HarmonyOS"
    portal_name = (cfg.get("portal_name") or "").strip() or "Huawei"

    params = {
        "callback": "sdu", "action": "login", "username": username,
        "password": "{MD5}" + hmd5, "ip": ip, "ac_id": str(acid), "n": str(n),
        "type": str(utype), "os": portal_os, "name": portal_name, "double_stack": "0",
        "info": info, "chksum": chksum, "_": str(int(time.time()) - 2),
    }
    url = "%s/cgi-bin/srun_portal?%s" % (server, urllib.parse.urlencode(params))
    result = parse_jsonp(http_get(url, 20))

    code = str(result.get("error") or result.get("res") or "")
    ploy = str(result.get("ploy_msg") or "")
    ok = code == "ok" or bool(result.get("access_token")) or ploy.startswith("E0000")
    msg = str(result.get("error_msg") or result.get("suc_msg") or code or "未知")
    detail = str(result.get("ploy_msg") or "")
    if ok and msg == "ip_already_online_error":
        msg = "当前设备已在线"

    return {"ok": ok, "kind": classify(ok, code, msg, detail), "msg": msg,
            "detail": detail, "code": code, "acid": acid, "ip": ip}


# ---------------- 上网协议 ----------------
def http_post_form(url, fields, timeout=8):
    data = urllib.parse.urlencode(fields).encode()
    if (BIND_IFACE or BIND_SOURCE) and url.startswith("http://"):
        u = urllib.parse.urlparse(url)
        conn = BoundHTTPConnection(u.hostname, u.port or 80, timeout=timeout)
        path = u.path or "/"
        if u.query:
            path += "?" + u.query
        try:
            conn.request("POST", path, body=data,
                         headers={"Content-Type": "application/x-www-form-urlencoded",
                                  "User-Agent": "gdou-srun"})
            return conn.getresponse().read().decode("utf-8", "replace")
        finally:
            conn.close()
    data = urllib.parse.urlencode(fields).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "gdou-srun/1.2",
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", "replace")


def parse_json(text):
    try:
        return json.loads(text)
    except ValueError:
        return parse_jsonp(text)


def fetch_agreement(cfg):
    """读取最新协议要求 + 本人已同意的协议 id 列表。"""
    server = cfg["server"]
    timeout = max(int(cfg.get("timeout") or 8), 6)
    latest = parse_json(http_get("%s/v1/srun_portal_agree_new?agree_type=1&_=%d" % (server, int(time.time())), timeout))
    data = (latest or {}).get("data") or None
    if not data or not data.get("id"):
        return {"required": False, "id": 0, "title": "", "agreed": True}

    agreed = parse_json(http_get(
        "%s/v1/srun_portal_agrees?user_name=%s&_=%d" % (
            server, urllib.parse.quote(cfg.get("username", "")), int(time.time())), timeout))
    ids = (agreed or {}).get("data")
    ids = ids if isinstance(ids, list) else []
    return {
        "required": True,
        "id": data.get("id"),
        "title": str(data.get("title") or "").strip(),
        "agreed": data.get("id") in ids,
    }


def bind_agreement(cfg, agree_id):
    """同意协议（绑定到账号）。"""
    server = cfg["server"]
    raw = http_post_form(
        "%s/v1/srun_portal_agree_bind" % server,
        {"agree_id": agree_id, "user_name": cfg.get("username", "")},
        timeout=max(int(cfg.get("timeout") or 8), 8),
    )
    res = parse_json(raw) or {}
    return {"ok": res.get("code") == 0, "message": str(res.get("message") or "")}


def ensure_agreement(cfg):
    """登录前确保协议已同意；auto_agree=1 时自动同意。"""
    try:
        info = fetch_agreement(cfg)
    except Exception as exc:  # noqa: BLE001
        return {"required": False, "agreed": True, "note": "查询协议失败: %s" % exc}

    if not info["required"] or info["agreed"]:
        return info
    if str(cfg.get("auto_agree", "1")) != "1":
        info["note"] = "协议未同意，且未开启自动同意"
        return info

    res = bind_agreement(cfg, info["id"])
    info["agreed"] = bool(res.get("ok"))
    info["note"] = "已自动同意协议" if info["agreed"] else ("同意协议失败: %s" % res.get("message"))
    return info


def classify(ok, code, msg, detail):
    if ok:
        return "ok"
    text = (detail + " " + msg).lower()
    if "agree" in text or "协议" in (msg + detail):
        return "agreement"
    if "speed_limit" in text or "频繁" in text:
        return "rate_limit"
    if re.search(r"bas|info|timeout|nas type|ac-type", text):
        return "ac"
    if code == "login_error" or "E2531" in code:
        return "password"
    return "other"


# ---------------- ac_id 解析 ----------------
def discover_acid(timeout=4):
    """未认证时访问外网会被门户劫持，跳转地址里带着本次连接真实的 ac_id。"""

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    opener = urllib.request.build_opener(NoRedirect)
    for url in PROBE_URLS:
        try:
            opener.open(url, timeout=timeout)
        except urllib.error.HTTPError as err:
            loc = err.headers.get("Location") or ""
            m = re.search(r"[?&]ac_id=(\d+)", loc)
            if m:
                return int(m.group(1))
        except Exception:  # noqa: BLE001
            continue
    return 0


def candidates(cfg):
    """ac_id 候选，按可信度排列，去重。"""
    order = []
    discovered = 0
    try:
        discovered = discover_acid()
    except Exception:  # noqa: BLE001
        discovered = 0

    def add(value, source):
        try:
            v = int(value)
        except (TypeError, ValueError):
            return
        if v > 0 and all(v != item[0] for item in order):
            order.append((v, source))

    saved = load_saved_acids()
    add(saved.get("manual") or cfg.get("manual_acid"), "手动")
    add(discovered, "重定向获取")
    add(saved.get("last_good") or cfg.get("last_good_acid"), "上次成功")
    add(cfg.get("acid"), "配置值")
    return order


def do_login(cfg):
    if not cfg.get("username") or not cfg.get("password"):
        return {"ok": False, "kind": "config", "msg": "未配置账号或密码"}

    # 占位符检查：必须在发请求之前拦住，否则会拿着假密码反复撞击门户风控。
    hint = placeholder_hint(cfg)
    if hint:
        return {"ok": False, "kind": "config", "msg": hint}

    agr = ensure_agreement(cfg)
    if agr.get("required") and not agr.get("agreed"):
        return {"ok": False, "kind": "agreement",
                "msg": agr.get("note") or "需要同意上网协议后才能登录"}

    tried = []
    last = None
    for acid, source in candidates(cfg)[:4]:
        tried.append("%s(%s)" % (acid, source))
        try:
            res = login_once(cfg, acid)
        except Exception as exc:  # noqa: BLE001
            res = {"ok": False, "kind": "network", "msg": str(exc), "acid": acid}

        res["source"] = source
        if res["ok"]:
            res["tried"] = ",".join(tried)
            save_acids(acid)
            return res

        last = res
        # 账号密码错 / 被限流 / 配置缺失：换 ac_id 也没用，立即停
        if res["kind"] in ("password", "rate_limit", "config"):
            res["tried"] = ",".join(tried)
            return res

    if last is None:
        return {"ok": False, "kind": "network", "msg": "没有可用的 ac_id 候选"}
    last["tried"] = ",".join(tried)
    return last


# ---------------- 登出 ----------------
def do_logout(cfg):
    """主动下线。srun 的登出不需要 checksum，带上本机 IP 与 ac_id 即可。"""
    server = cfg["server"]
    username = cfg.get("username", "")
    timeout = 10

    first = get_challenge(server, username, timeout)
    ip = first.get("online_ip") or first.get("client_ip") or ""
    if not ip:
        return {"ok": False, "msg": "认证服务器未返回本机 IP"}

    acid = 0
    for value, _src in candidates(cfg):
        acid = value
        break
    if not acid:
        acid = int(cfg.get("acid") or 25)

    url = "%s/cgi-bin/srun_portal?%s" % (server, urllib.parse.urlencode({
        "callback": "sdu",
        "action": "logout",
        "username": username,
        "ip": ip,
        "ac_id": str(acid),
        "_": str(int(time.time()) - 2),
    }))
    result = parse_jsonp(http_get(url, 20))

    code = str(result.get("error") or result.get("res") or "")
    ploy = str(result.get("ploy_msg") or "")
    ok = code == "ok" or bool(result.get("access_token")) or ploy.startswith("E0000")
    msg = str(result.get("error_msg") or result.get("suc_msg") or code or "未知")
    if ok:
        msg = "已登出"
    return {"ok": ok, "msg": msg, "code": code, "acid": acid, "ip": ip}


# ---------------- 定时重连 ----------------
def do_renew(cfg, gap=5):
    """下线，等待若干秒，再重新登录。用于定时刷新会话。"""
    try:
        gap = int(gap)
    except (TypeError, ValueError):
        gap = 5
    gap = max(0, min(60, gap))

    out = {"gap": gap}
    try:
        out["logout"] = do_logout(cfg)
    except Exception as exc:  # noqa: BLE001
        out["logout"] = {"ok": False, "msg": str(exc)}

    if gap:
        time.sleep(gap)

    try:
        out["login"] = do_login(cfg)
    except Exception as exc:  # noqa: BLE001
        out["login"] = {"ok": False, "kind": "network", "msg": str(exc)}

    out["ok"] = bool((out.get("login") or {}).get("ok"))
    return out


# ---------------- 连通性 ----------------
def _tcp_ok(host, port, timeout=3):
    try:
        sock = socket.create_connection((host, port), timeout=timeout)
        sock.close()
        return True
    except OSError:
        return False


_PORTAL_CACHE = {"t": 0, "v": None, "ttl": 30}


def portal_state(cfg):
    """直接问门户：本机这个 IP 现在算不算已认证。

    返回 True（在线）/ False（明确未在线）/ None（无法判断）。
    只把 error==ok 当权威肯定；其余交给调用方的 HTTP 探测。
    """
    now = int(time.time())
    if now - _PORTAL_CACHE["t"] < _PORTAL_CACHE.get("ttl", 30):
        return _PORTAL_CACHE["v"]

    try:
        url = "%s/cgi-bin/rad_user_info?%s" % (
            cfg.get("server", "http://10.129.1.1").rstrip("/"),
            urllib.parse.urlencode({"callback": "sdu", "_": str(now)}))
        data = parse_jsonp(http_get(url, 6))
    except Exception:  # noqa: BLE001
        return None
    err = str(data.get("error") or "")
    _PORTAL_CACHE["t"] = now
    _PORTAL_CACHE["v"] = True if err == "ok" else None
    # 被限速/限流时降低查询频率，避免惩罚一直续期
    _PORTAL_CACHE["ttl"] = 600 if "speed_limit" in err else 30
    if err == "ok":
        return True
    # 注意：门户对「从某个 IP 查自己」会返回 not_online_error，即使该 IP 确实在线
    # （实测：从 .211 查自己说未在线，从 .246 查同一账号却说两台都在线）。
    # 所以这里只把 ok 当权威肯定，其余一律返回 None 交给 HTTP 探测，避免误判离线导致疯狂重登。
    return None


def online(cfg):
    """是否已联网。

    校园网未认证时 TCP 连接照样能建立（被认证门户劫持），
    所以不能只看 TCP。这里发一个 HTTP 请求，检查是否被跳到认证门户。
    网络层直接失败时再回退到 TCP 判定。
    """
    # 首选：直接问门户（权威）。问到明确结果就不再猜。
    st = portal_state(cfg)
    if st is not None:
        return st

    host = cfg.get("test_host") or "www.baidu.com"
    port = int(cfg.get("test_port") or 80)
    timeout = 4

    conn = None
    try:
        conn = http.client.HTTPConnection(host, port, timeout=timeout)
        conn.request("GET", "/", headers={"User-Agent": "gdou-srun/1.3"})
        resp = conn.getresponse()
        status = resp.status
        location = (resp.getheader("Location") or "").lower()
        body = resp.read(65536).decode("utf-8", "replace").lower()
    except Exception:  # noqa: BLE001
        return _tcp_ok(host, port)
    finally:
        try:
            if conn is not None:
                conn.close()
        except Exception:  # noqa: BLE001
            pass

    # 被重定向到认证门户 -> 未认证
    if 300 <= status < 400:
        if "10.129." in location or "cgi-bin" in location or "srun" in location:
            return False
        return True

    # 返回体是认证页 -> 未认证
    for marker in ("srun_portal", "cgi-bin/srun", "深澜", "校园网认证"):
        if marker in body:
            return False

    return 200 <= status < 400


def write_state(payload):
    try:
        with open(STATE, "w", encoding="utf-8") as fh:
            json.dump(payload, fh, ensure_ascii=False)
    except OSError:
        pass


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "login"
    cfg = read_config()

    if cmd == "check":
        return 0 if online(cfg) else 1

    if cmd == "status":
        try:
            with open(STATE, "r", encoding="utf-8") as fh:
                print(fh.read())
        except OSError:
            print('{"ok":false,"msg":"尚无记录"}')
        return 0

    if cmd == "acid":
        for acid, source in candidates(cfg):
            print("%s -> %s" % (acid, source))
        return 0

    if cmd == "renew":
        gap = sys.argv[2] if len(sys.argv) > 2 else cfg.get("renew_gap", "5")
        try:
            res = do_renew(cfg, gap)
        except Exception as exc:  # noqa: BLE001
            res = {"ok": False, "msg": str(exc)}
        res["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
        write_state(res.get("login") or res)
        print(json.dumps(res, ensure_ascii=False))
        return 0 if res.get("ok") else 1

    if cmd == "logout":
        try:
            res = do_logout(cfg)
        except Exception as exc:  # noqa: BLE001
            res = {"ok": False, "msg": str(exc)}
        res["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
        write_state(res)
        print(json.dumps(res, ensure_ascii=False))
        return 0 if res.get("ok") else 1

    if cmd == "login":
        if cfg.get("enabled", "1") != "1":
            print('{"ok":false,"kind":"disabled","msg":"已停用"}')
            return 0
        try:
            res = do_login(cfg)
        except Exception as exc:  # noqa: BLE001
            res = {"ok": False, "kind": "network", "msg": str(exc)}
        res["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
        write_state(res)
        print(json.dumps(res, ensure_ascii=False))
        return 0 if res.get("ok") else 1

    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
