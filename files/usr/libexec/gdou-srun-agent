#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""gdou-srun 常驻守护进程

替代原来的 shell 守护进程。原实现每 3 秒 fork 一次 python 做探测：
  单次 0.44s CPU × 28800 次/天 = 3.5 小时 CPU/天，约占单核 14.7%。

本实现要点：
  1. 单进程常驻，gdou-srun 只导入一次
  2. 直接复用 gdou-srun 里的 portal_state 缓存（30s，限速时 600s）
     → 热路径完全不发网络请求
  3. 状态机 ONLINE / OFFLINE / AUTHING / COOLDOWN
     → 只在状态翻转时写日志，不再刷屏
  4. 登录失败指数退避（5→10→20→40→60s），不骚扰门户
  5. 链路静默检测：收包长期不增长时不盲目重试
  6. 定时重连 / 多链路同步 / 分流同步 / IPv6 模式 / 备份切换 统一在这里调度
"""

import importlib.util
import json
import os
import re
import subprocess
import sys
import threading
import time

LIBEXEC = "/usr/libexec"
CONFIG = os.environ.get("GDOU_CONFIG", "/etc/config/gdou-srun")
LOG = "/tmp/gdou-srun.log"
PAUSE = "/tmp/gdou-srun.pause"
BK_MARK = "/tmp/gdou-backup.on"
SYNC_EVERY = 60          # 多链路/分流/IPv6 同步周期
CFG_EVERY = 5            # 配置重读周期
PROBE_ONLINE = 10        # 在线时的探测间隔
PROBE_OFFLINE = 3        # 离线时的探测间隔
BACKOFF = [5, 10, 20, 40, 60]
# 自动重启的安全边界：太频繁重启本身就是故障，宁可不动
REBOOT_MIN_UPTIME = 3600      # 失败触发的重启，开机不足 1 小时不执行
REBOOT_ON_FAIL_GAP = 3600     # 两次失败触发之间至少间隔 1 小时
# 门户 BAS 类错误（限流/设备忙）单独用更长的退避，短时间重试只会加重限流
BACKOFF_AC = [30, 60, 120, 300]

# ---------------------------------------------------------------- 日志

def log(ev, **kw):
    """写一行日志：时间戳 + JSON。只保留最近 200 行。"""
    kw["ev"] = ev
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"),
                      json.dumps(kw, ensure_ascii=False, sort_keys=False))
    try:
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
        with open(LOG, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
        if len(lines) > 200:
            with open(LOG, "w", encoding="utf-8") as fh:
                fh.writelines(lines[-200:])
    except OSError:
        pass


# ---------------------------------------------------------------- 配置

_CFG_CACHE = {"t": 0, "v": {}}


def load_cfg(force=False):
    """直接解析 /etc/config/gdou-srun，避免每次 fork uci。"""
    now = time.time()
    if not force and now - _CFG_CACHE["t"] < CFG_EVERY and _CFG_CACHE["v"]:
        return _CFG_CACHE["v"]

    cfg = {}
    try:
        with open(CONFIG, "r", encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                m = re.match(r"option\s+(\S+)\s+'?([^']*)'?$", line)
                if m:
                    cfg[m.group(1)] = m.group(2).strip()
    except OSError:
        pass

    # 神秘字段兜底：解析失败就退回 uci（只会在异常时 fork 一次）
    if not cfg.get("server"):
        try:
            out = subprocess.run(["uci", "-q", "show", "gdou-srun"],
                                 capture_output=True, text=True, timeout=10).stdout
            for m in re.finditer(r"\.(\w+)='([^']*)'", out):
                cfg[m.group(1)] = m.group(2)
        except Exception:  # noqa: BLE001
            pass

    _CFG_CACHE["t"] = now
    _CFG_CACHE["v"] = cfg
    return cfg


def cfg_sig(cfg):
    """配置指纹，用来发现变更。"""
    keys = ("username", "password", "advanced", "dual_same_account", "split_mode",
            "sub1_enabled", "sub2_enabled", "sub3_enabled", "sub1_dual", "sub2_dual",
            "sub3_dual", "renew_enable", "renew_times", "ipv6_mode", "auto_apply")
    return "|".join("%s=%s" % (k, cfg.get(k, "")) for k in keys)


# ---------------------------------------------------------------- 外部脚本

def run(script, args=None, timeout=90):
    """调用子进程脚本。只在真正需要动作时用。"""
    cmd = [os.path.join(LIBEXEC, script)] + list(args or [])
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, (p.stdout or "").strip(), (p.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return False, "", "timeout"
    except Exception as exc:  # noqa: BLE001
        return False, "", str(exc)


def uci_set(key, value):
    """写 uci（只在确实需要改的时候调用，避免反复 fork）。"""
    try:
        subprocess.run(["uci", "-q", "set", "%s=%s" % (key, value)], timeout=10)
        return True
    except Exception:  # noqa: BLE001
        return False


# ---------------------------------------------------------------- 导入认证核心

def load_auth():
    """把 gdou-srun 当模块导入（它有 __main__ 保护，import 不会执行命令）。

    注意：gdou-srun 没有 .py 扩展名，importlib.util.spec_from_file_location()
    对它返回 None，必须显式用 SourceFileLoader。
    """
    from importlib.machinery import SourceFileLoader
    path = os.path.join(LIBEXEC, "gdou-srun")
    loader = SourceFileLoader("gdou_srun_core", path)
    spec = importlib.util.spec_from_loader("gdou_srun_core", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# ---------------------------------------------------------------- 链路活性

PERSIST_DIR = "/etc/gdou-srun"
PERSIST_EVENTS = PERSIST_DIR + "/events.log"
REBOOT_HELPER = "/usr/libexec/gdou-srun-reboot"


REBOOT_SLOT_FILE = PERSIST_DIR + "/last-reboot-slot"


def read_reboot_slot():
    """读取「本分钟已经重启过」的持久记录。

    这个必须持久化：定时重启发生在 05:00，重启后开机仍可能落在 05:00 这一分钟内，
    如果只记在内存里，就会再次触发重启 —— 实测 2026-11-20 05:00 连重启了 3 次。
    """
    try:
        with open(REBOOT_SLOT_FILE, "r", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def write_reboot_slot(slot):
    try:
        os.makedirs(PERSIST_DIR, exist_ok=True)
        with open(REBOOT_SLOT_FILE, "w", encoding="utf-8") as fh:
            fh.write(slot)
    except OSError:
        pass


def persist_event(text):
    """把关键事件写进持久存储。

    /tmp 是内存盘，重启即失；/etc 在 overlay 上，掉电也能保留。
    只记录状态翻转、重启这类低频事件，避免写坏闪存。
    """
    try:
        os.makedirs(PERSIST_DIR, exist_ok=True)
        with open(PERSIST_EVENTS, "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), text))
        with open(PERSIST_EVENTS, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
        if len(lines) > 300:
            with open(PERSIST_EVENTS, "w", encoding="utf-8") as fh:
                fh.writelines(lines[-300:])
    except OSError:
        pass


def read_uptime():
    try:
        with open("/proc/uptime") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 0.0


def rx_packets(dev="eth0"):
    try:
        with open("/sys/class/net/%s/statistics/rx_packets" % dev) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return -1


# ---------------------------------------------------------------- 主循环

class Agent:
    def __init__(self):
        self.core = load_auth()
        self.state = "unknown"      # online / offline / authing
        self.prev_logged = None
        self.backoff_idx = 0
        self.next_login = 0
        self.last_sync = 0
        self.last_cfg = 0
        self.last_sig = ""
        self.last_renew_day = ""
        self.last_renew_slot = ""
        self.silent = 0             # 连续静默次数
        self.last_rx = -1
        self.last_rx_t = 0
        self.renew_fail = 0
        self._bg = {}
        self.offline_since = 0
        self.fail_streak = 0
        self.last_reboot_slot = ""
        self.reboot_uptime_noted = False
        self.last_reboot_at = 0

    # ---------- 状态翻转 ----------
    def set_state(self, new, why=""):
        if new == self.state:
            return
        old = self.state
        self.state = new
        if old != "unknown":
            log("state", **{"from": old, "to": new, "why": why})
            persist_event("state %s -> %s%s" % (old, new, (" (%s)" % why) if why else ""))
        else:
            log("start", state=new)

    # ---------- 调度 ----------
    def tick(self):
        now = time.time()
        cfg = load_cfg()

        if cfg.get("enabled", "1") != "1":
            self.set_state("disabled", "配置里已停用")
            time.sleep(5)
            return

        if os.path.exists(PAUSE):
            self.set_state("paused", "主链路被手动下线")
            time.sleep(5)
            return

        # 配置变更
        if now - self.last_cfg >= CFG_EVERY:
            self.last_cfg = now
            sig = cfg_sig(cfg)
            if sig != self.last_sig:
                if self.last_sig:
                    log("config_changed", auto_apply=cfg.get("auto_apply", "0"))
                    if cfg.get("auto_apply") == "1":
                        ok, out, _ = run("gdou-srun-apply", timeout=120)
                        log("apply", ok=ok, out=out[-160:])
                self.last_sig = sig

        # 自动重启（定时 / 认证连续失败后）
        self.maybe_reboot(cfg)

        # 周期性同步（多链路 / 分流 / IPv6）：这些脚本本身是幂等的
        if now - self.last_sync >= SYNC_EVERY:
            self.last_sync = now
            self.sync_all(cfg)

        # 探测
        try:
            online = self.core.online(cfg)
        except Exception as exc:  # noqa: BLE001
            log("probe_error", msg=str(exc)[:120])
            online = False

        if online:
            self.set_state("online", "门户/HTTP 探测通过")
            self.backoff_idx = 0
            self.silent = 0
            self.after_online(cfg)
            time.sleep(PROBE_ONLINE)
            return

        # ---- 离线 ----
        if self.state != "offline":
            # 记住第一次判定离线的时刻：链路抖动（1~2 秒）不该立刻触发登录
            self.offline_since = now
        self.set_state("offline", "探测未通过")
        self.after_offline(cfg)
        time.sleep(PROBE_OFFLINE)

    # ---------- 在线时该做的事 ----------
    def after_online(self, cfg):
        # 备份模式：主链路恢复就切回来
        if cfg.get("split_mode") == "backup" and os.path.exists(BK_MARK):
            ok, _, _ = run("gdou-srun-split", ["backup", "off"], timeout=60)
            if ok:
                try:
                    os.unlink(BK_MARK)
                except OSError:
                    pass
                log("backup_off", why="主链路已恢复")

        self.maybe_renew(cfg)

    # ---------- 定时重连 ----------
    def maybe_renew(self, cfg):
        if cfg.get("renew_enable", "1") != "1":
            return
        times = (cfg.get("renew_times") or "").replace(",", " ").split()
        if not times:
            return
        now = time.localtime()
        hhmm = "%02d%02d" % (now.tm_hour, now.tm_min)
        day = time.strftime("%Y%m%d")
        slot = day + hhmm
        if hhmm in times and slot != self.last_renew_slot:
            self.last_renew_slot = slot
            gap = cfg.get("renew_gap", "5")
            log("renew_start", at=hhmm, gap=gap)
            ok, out, err = run("gdou-srun", ["renew", str(gap)], timeout=150)
            detail = out or err
            if '"skipped": true' in detail:
                # 门户不健康，本次什么都没做（没有登出，网络保持原样）
                log("renew_skipped", at=hhmm, why="门户前置探测失败")
                return
            log("renew_done", ok=ok, detail=detail[-200:])
            if not ok:
                self.renew_fail += 1
                log("renew_failed", count=self.renew_fail)

    # ---------- 自动重启 ----------
    def maybe_reboot(self, cfg):
        """两种触发：定时重启、认证连续失败后重启。

        失败触发的重启是「端口被校园网禁用」的兜底——重启会重新协商链路，
        实测能把被 err-disable 的端口救回来。但重启是重手段，加了两道闸：
        开机不足 1 小时不重启、两次失败触发至少间隔 1 小时，避免重启循环。
        """
        now = time.time()

        # ① 定时重启
        if cfg.get("reboot_enable") == "1":
            times = (cfg.get("reboot_times") or "").replace(",", " ").split()
            if times:
                lt = time.localtime()
                hhmm = "%02d%02d" % (lt.tm_hour, lt.tm_min)
                slot = time.strftime("%Y%m%d") + hhmm
                if hhmm in times and slot != self.last_reboot_slot:
                    # 保护1：持久记录说这一分钟已经重启过，就不再来一次
                    if read_reboot_slot() == slot:
                        self.last_reboot_slot = slot
                        return
                    # 保护2：开机不足 10 分钟不执行定时重启（防止重启循环）
                    if read_uptime() < 600:
                        if not self.reboot_uptime_noted:
                            self.reboot_uptime_noted = True
                            log("reboot_skip", why="开机不足 10 分钟，跳过定时重启")
                        return
                    self.last_reboot_slot = slot
                    write_reboot_slot(slot)
                    self.do_reboot("定时重启 %s" % hhmm)

        # ② 认证连续失败
        if cfg.get("reboot_on_fail") == "1":
            try:
                threshold = int(cfg.get("reboot_fail_threshold") or 20)
            except (TypeError, ValueError):
                threshold = 20
            if threshold < 3:
                threshold = 3
            if self.fail_streak >= threshold:
                uptime = read_uptime()
                if uptime < REBOOT_MIN_UPTIME:
                    if self.fail_streak == threshold:
                        log("reboot_skip", why="开机不足 1 小时", uptime=int(uptime))
                elif now - self.last_reboot_at < REBOOT_ON_FAIL_GAP:
                    if self.fail_streak == threshold:
                        log("reboot_skip", why="距上次自动重启不足 1 小时")
                else:
                    self.last_reboot_at = now
                    self.do_reboot("认证连续失败 %d 次" % self.fail_streak)

    def do_reboot(self, why):
        log("reboot", why=why)
        persist_event("reboot requested: %s" % why)
        time.sleep(1)
        try:
            # 走助手脚本：它会先把日志抄到 /etc/gdou-srun/ 再重启，
            # 否则重启后 /tmp 里的日志全没了，事后查不到为什么重启。
            subprocess.run([REBOOT_HELPER, why], timeout=15)
        except Exception as exc:  # noqa: BLE001
            log("reboot_failed", msg=str(exc)[:120])
            try:
                subprocess.run(["/sbin/reboot"], timeout=10)
            except Exception:  # noqa: BLE001
                pass

    # ---------- 离线时该做的事 ----------
    def after_offline(self, cfg):
        # 链路静默检测：收包长期不动说明是物理/对端问题，重试没意义
        rx = rx_packets()
        now = time.time()
        if rx >= 0 and self.last_rx >= 0 and now - self.last_rx_t > 20:
            if rx <= self.last_rx:
                self.silent += 1
                if self.silent == 3:
                    log("link_silent", rx=rx, msg="收包长期不增长，暂停登录尝试")
            else:
                if self.silent >= 3:
                    log("link_alive", rx=rx)
                self.silent = 0
            self.last_rx = rx
            self.last_rx_t = now
        elif self.last_rx < 0:
            self.last_rx = rx
            self.last_rx_t = now

        if self.silent >= 3:
            return          # 链路都不通，别撞门户

        # 备份模式：主链路掉线就把局域网切到虚拟链路。
        # 注意：这里不能每轮（3 秒）都起子进程查状态，否则断网时会变成
        # 「每 3 秒 fork 一个 python」——正是重构前要消灭的开销。
        now = time.time()
        if cfg.get("split_mode") == "backup" and os.path.exists("/sys/class/net/mcv0"):
            if not os.path.exists(BK_MARK) and now - self.last_bk_probe >= 30:
                self.last_bk_probe = now
                ok, out, _ = run("gdou-srun-dual", ["status"], timeout=40)
                if '"authed": true' in out:
                    ok2, _, _ = run("gdou-srun-split", ["backup", "on"], timeout=60)
                    if ok2:
                        log("backup_on", why="主链路掉线，切到虚拟链路")
                    else:
                        log("backup_on_failed")
            return

        # 退避后尝试登录
        now = time.time()
        if now < self.next_login:
            return

        # 冷却闸门：离线时间不足 login_cooldown 秒就先不动。
        # 旧 shell 守护进程就是这么做的——链路抖动 1~2 秒不会触发重新认证，
        # 而「一抖动就登录」正是之前被门户 BAS 限流的直接原因。
        try:
            cooldown = int(cfg.get("login_cooldown") or 10)
        except (TypeError, ValueError):
            cooldown = 10
        if now - self.offline_since < cooldown:
            return
        self.set_state("authing", "准备登录")
        ok, out, err = run("gdou-srun", ["login"], timeout=150)
        detail = (out or err)[-220:]
        if ok:
            log("login_ok", detail=detail)
            self.backoff_idx = 0
            self.next_login = 0
            self.fail_streak = 0
            self.set_state("online", "登录成功")
        else:
            # 区分「网络不通」和「门户 BAS 限流」：后者要退得更久
            ac_fail = '"kind": "ac"' in detail
            table = BACKOFF_AC if ac_fail else BACKOFF
            wait = table[min(self.backoff_idx, len(table) - 1)]
            self.backoff_idx += 1
            self.fail_streak += 1
            self.next_login = time.time() + wait
            if ac_fail:
                log("login_throttled", detail=detail[-160:], retry_in=wait,
                    msg="门户 BAS 限流，延长退避")
            else:
                log("login_failed", detail=detail, retry_in=wait)

    # ---------- 周期同步 ----------
    def sync_all(self, cfg):
        """周期性同步：多链路 / 分流 / IPv6。

        两个要点（对齐旧 shell 守护进程的行为）：
        1. 多链路只在真的用到时才同步（advanced / dual / mcv0 存在），
           否则每次白跑一遍 plan，没意义。
        2. 同步放到后台线程执行，不要阻塞探测循环——同步里可能等 DHCP、
           等登录，最长几分钟；一旦阻塞，断线检测就停了。
        """
        adv = cfg.get("advanced") == "1"
        dualc = cfg.get("dual_same_account") == "1"
        has_mcv = os.path.exists("/sys/class/net/mcv0")

        if adv or dualc or has_mcv:
            self._spawn("dual", lambda: self._run_sync("gdou-srun-dual", "dual_sync_failed"))

        smode = cfg.get("split_mode") or "backup"
        if smode != "off" and has_mcv:
            self._spawn("split", lambda: self._run_sync("gdou-srun-split", "split_sync_failed"))

        self.sync_ipv6(cfg)

    def _spawn(self, name, fn):
        """起一个后台线程干活；同名线程还在跑就跳过这一轮。"""
        if name in self._bg:
            return
        th = threading.Thread(target=self._bg_wrap, args=(name, fn), daemon=True)
        self._bg[name] = th
        th.start()

    def _bg_wrap(self, name, fn):
        try:
            fn()
        except Exception as exc:  # noqa: BLE001
            log("sync_error", which=name, msg=str(exc)[:120])
        finally:
            self._bg.pop(name, None)

    def _run_sync(self, script, tag):
        ok, out, err = run(script, ["sync"], timeout=180)
        if not ok and (out or err):
            log(tag, detail=(out or err)[-160:])

    # ---------- IPv6 三档 ----------
    def sync_ipv6(self, cfg):
        mode = cfg.get("ipv6_mode", "")
        if not mode:
            mode = "full" if cfg.get("ipv6") == "1" else "off"
        if mode not in ("off", "campus", "full"):
            mode = "off"

        # wan6
        dis = subprocess.run(["uci", "-q", "get", "network.wan6.disabled"],
                             capture_output=True, text=True, timeout=8).stdout.strip()
        if mode == "off" and dis != "1":
            uci_set("network.wan6.disabled", "1")
            subprocess.run(["uci", "-q", "commit", "network"], timeout=10)
            subprocess.run(["/sbin/ifdown", "wan6"], timeout=20)
            log("ipv6", wan6="off")
        elif mode != "off" and dis == "1":
            uci_set("network.wan6.disabled", "0")
            subprocess.run(["uci", "-q", "commit", "network"], timeout=10)
            subprocess.run(["/sbin/ifup", "wan6"], timeout=20)
            log("ipv6", wan6="on", mode=mode)

        # LAN 路由通告
        ra = subprocess.run(["uci", "-q", "get", "dhcp.lan.ra"],
                            capture_output=True, text=True, timeout=8).stdout.strip()
        rad = subprocess.run(["uci", "-q", "get", "dhcp.lan.ra_default"],
                             capture_output=True, text=True, timeout=8).stdout.strip()
        changed = False
        if mode == "off":
            if ra != "disabled":
                uci_set("dhcp.lan.ra", "disabled")
                uci_set("dhcp.lan.dhcpv6", "disabled")
                changed = True
        elif mode == "campus":
            if ra != "server":
                uci_set("dhcp.lan.ra", "server")
                changed = True
            if rad != "0":
                uci_set("dhcp.lan.ra_default", "0")
                changed = True
        else:
            if ra != "server":
                uci_set("dhcp.lan.ra", "server")
                changed = True
            if rad != "1":
                uci_set("dhcp.lan.ra_default", "1")
                changed = True
        if changed:
            subprocess.run(["uci", "-q", "commit", "dhcp"], timeout=10)
            subprocess.run(["/etc/init.d/odhcpd", "restart"], timeout=30)
            log("ipv6", lan="off" if mode == "off" else ("campus" if mode == "campus" else "full"))

    # ---------- 启动 ----------
    def run_forever(self):
        log("boot", version="3.2.1-agent", pid=os.getpid())
        persist_event("boot pid=%d" % os.getpid())
        while True:
            try:
                self.tick()
            except KeyboardInterrupt:
                log("exit", signal="SIGINT")
                return 0
            except Exception as exc:  # noqa: BLE001
                log("loop_error", msg=("%s: %s" % (type(exc).__name__, exc))[:200])
                time.sleep(5)


if __name__ == "__main__":
    sys.exit(Agent().run_forever())
