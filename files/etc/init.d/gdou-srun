#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

start_service() {
	procd_open_instance
	# 常驻 Python 守护：进程内循环探测，不再每 3 秒 fork 一次解释器
	# （旧实现实测 0.44s CPU/次 × 28800 次/天 ≈ 3.5 小时 CPU/天）
	procd_set_param command /usr/libexec/gdou-srun-agent
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	# 这里刻意不注册任何自动触发器，原因有两条：
	#
	# 1. 曾经有 procd_add_interface_trigger "interface.*" "*"
	#    —— 任何接口事件（含 LAN 侧电脑开关机的 DHCP 变化）都会重启进程并重新认证，
	#    短时间内多次认证会被门户 BAS 限流，表现为「电脑开关机就掉认证」。
	#
	# 2. 曾经有 procd_add_reload_trigger "gdou-srun"
	#    —— 只要 uci 配置 commit 就重启服务，而插件登录成功后会写回 ac_id，
	#    等于每次登录成功都把自己重启一次。
	#
	# 守护进程每 5 秒重读一次配置，接口恢复也会在 3~10 秒内自行发现，
	# 完全不需要事件触发。需要立即生效时用「立即重连」按钮或 /etc/init.d/gdou-srun restart。
	:
}