#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

start_service() {
	procd_open_instance
	# 常驻 Python 守护：进程内循环探测，不再每 3 秒 fork 一次解释器
	# （旧实现实测 0.44s CPU/次 × 28800 次/天 ≈ 3.5 小时 CPU/天）
	procd_set_param command /usr/libexec/gdou-srun-agent
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "gdou-srun"
	procd_add_interface_trigger "interface.*" "*" /etc/init.d/gdou-srun reload
}